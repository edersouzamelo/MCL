# MCL em servidor local / intranet
# Alvo institucional confirmado: Ubuntu 26.04, IP fixo 10.56.120.28.
# Copie para .env.intranet e substitua todos os CHANGE_ME antes de iniciar.

POSTGRES_DB=mcl_local
POSTGRES_USER=mcl_app
# Use senha longa alfanumerica para evitar necessidade de URL-encoding.
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_START

# Endereco fixo que os computadores da intranet usarao para abrir o MCL.
MCL_BASE_URL=http://10.56.120.28:3000
MCL_HTTP_PORT=3000

# Gere um segredo longo e aleatorio.
AUTH_SECRET=CHANGE_ME_BEFORE_START

# Para intranet HTTP, mantenha false. Se a STI publicar o MCL em HTTPS, altere para true.
MCL_COOKIE_SECURE=false

# Login local opcional. Em implantacao com copia do banco atual, preserve os usuarios existentes.
DEMO_AUTH_ENABLED=false
DEMO_USER_PASSWORD=

# Nao execute seed por padrao em ambiente institucional.
# Use true somente em uma instalacao de teste vazia e volte para false depois.
MCL_RUN_SEED=false

# O primeiro boot compila o Next.js no proprio servidor.
MCL_REBUILD_ON_START=true

# OAuth e conectores externos sao opcionais e dependem de saida para a Internet.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
COMPRAS_GOV_SYNC_ENABLED=false
COMPRAS_GOV_API_BASE_URL=https://dadosabertos.compras.gov.br
