# Copie para .env.local e preencha localmente. Nunca versione valores reais.
AUTH_SECRET=
DEMO_AUTH_ENABLED=false
DEMO_USER_PASSWORD=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=
DIRECT_URL=
MCL_ALLOW_MEMORY_FALLBACK=false

# Opcionais: estes valores já são os padrões do Assistente IA.
# Na Vercel, a autenticação do AI Gateway usa VERCEL_OIDC_TOKEN injetado pelo projeto;
# não crie nem versione AI_GATEWAY_API_KEY para este fluxo.
MCL_AI_PROVIDER=vercel-oidc
MCL_AI_MODEL=openai/gpt-5-mini
